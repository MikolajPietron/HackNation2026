# Skopiuj do backend/.env i uzupełnij. Plik .env jest w .gitignore.

# Supabase. Lokalnie: `npm run db:start`, potem wartości z `npm run db:status`
# (API URL oraz secret key / service_role key). Na produkcji: dane projektu z supabase.com.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=

# LLM asystenta czatu (Pydantic AI). Dostawca: openrouter (domyślnie) albo anthropic.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Tylko przy LLM_PROVIDER=anthropic:
ANTHROPIC_API_KEY=
# Pusty = domyślny model dostawcy (Claude Opus 5.5: anthropic/claude-opus-5.5 w OpenRouter).
LLM_MODEL=
# Wysiłek myślenia modelu (minimal|low|medium|high|xhigh|max); brak = domyślny (adaptive).
# LLM_THINKING=low

# Adresy frontendu dopuszczone przez CORS (lista w JSON)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
