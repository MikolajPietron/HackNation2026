# Skopiuj do backend/.env i uzupełnij. Plik .env jest w .gitignore.

# Supabase. Lokalnie: `npm run db:start`, potem wartości z `npm run db:status`
# (API URL oraz secret key / service_role key). Na produkcji: dane projektu z supabase.com.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=

# Claude: asystent czatu (Pydantic AI), później odczyt skanów spraw
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Wysiłek myślenia modelu (minimal|low|medium|high|xhigh|max); brak = domyślny (adaptive).
# LLM_THINKING=low

# Adresy frontendu dopuszczone przez CORS (lista w JSON)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
