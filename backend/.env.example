# Skopiuj do backend/.env i uzupełnij. Plik .env jest w .gitignore.

# Supabase: tabela `sessions` (rozmowy i odpowiedzi z wywiadu). Tylko backend, kluczem sekretnym
# (Project Settings → API keys: secret key albo service_role). Puste = sesje w plikach JSON
# w SESSIONS_DIR (domyślnie backend/.sessions, poza gitem), więc przeżywają restart backendu.
# Lokalnie: `npm run db:start`, potem wartości z `npm run db:status`.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SESSIONS_DIR=.sessions

# LLM asystenta czatu (Pydantic AI). Dostawca: openrouter (domyślnie), anthropic albo google
# (Gemini, klucz GEMINI_API_KEY niżej; domyślny model czatu gemini-flash-latest).
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Tylko przy LLM_PROVIDER=anthropic:
ANTHROPIC_API_KEY=
# Pusty = domyślny model dostawcy (Claude Opus 5.5: anthropic/claude-opus-5.5 w OpenRouter).
LLM_MODEL=
# Wysiłek myślenia przy odpowiedziach czatu (minimal|low|medium|high|xhigh|max); brak = low.
# Powitanie po onboardingu (zdarzenie timeline_ready) zawsze myśli minimalnie.
# LLM_THINKING=low
# Zapasowy model tego samego dostawcy (ten sam klucz), gdy główny po jednej ponownej próbie
# nadal zwraca 429, jest przeciążony albo nieosiągalny. Pusty = bez zapasowego. Np. przy google:
# gemini-flash-lite-latest; przy anthropic: claude-haiku-5-5.
LLM_FALLBACK_MODEL=
# Tylko lokalnie, do tools/eval: czat przez Claude Code CLI (`claude -p`) na Twojej subskrypcji
# claude.ai zamiast klucza API (opus, sonnet albo pełne id modelu). Pusty = wyłączone. Nigdy na
# serwerze.
CLAUDE_CODE_MODEL=

# Adresy frontendu dopuszczone przez CORS (lista w JSON)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Przykładowe sprawy ZUS (skany PDF, poufne, nigdy w gicie): folder z plikami. Pusty =
# docs/dokumentyZUS/sprawy. Nazwa z odstępem na końcu musi być w cudzysłowie.
CASES_DIR=
# Gdzie trzymać dane odczytane ze spraw (poza gitem), względem backend/.
CASES_CACHE_DIR=.cases_cache
# Model czytający skany spraw: tylko Claude albo Gemini (decyzja zespołu), niezależnie od
# LLM_MODEL czatu. Pusty = Claude Opus 5.5 dostawcy; "gemini-…" (np. gemini-pro-latest) = Google.
CASES_MODEL=
# Klucz Google AI Studio, gdy CASES_MODEL to model Gemini.
GEMINI_API_KEY=
